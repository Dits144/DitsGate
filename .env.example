# Server only. Never prefix these with VITE_ or expose in client code.
DITSGATE_DB=data/ditsgate.sqlite
DITSGATE_HOST=127.0.0.1
DITSGATE_API_PORT=5180
DITSGATE_ALLOW_ORIGIN=https://ditsgate.prefixxx.web.id
DITSGATE_ADMIN_EMAIL=admin@prefixxx.web.id
DITSGATE_ADMIN_TOPUP_QRIS=

# Frontend build-time API URL (opsional jika frontend & /api berada di subdomain yang sama)
VITE_DITSGATE_API_URL=https://ditsgate.prefixxx.web.id

# Incoming QRISGate provider webhook HMAC secret ONLY, configured by authorized operator.
# Never use this for merchant outbound webhook settings. Do not commit actual secrets.
QRISGATE_WEBHOOK_SECRET=

# Official ShopeePay transaction check (not Shopee Partner portal credentials).
SHOPEEPAY_ENV=
SHOPEEPAY_CLIENT_ID=
SHOPEEPAY_SECRET=
SHOPEEPAY_MERCHANT_EXT_ID=
SHOPEEPAY_STORE_EXT_ID=

# Shopee Partner portal token encryption key, server-only; generate 32 random bytes as base64url.
DITSGATE_PORTAL_ENCRYPTION_KEY=
