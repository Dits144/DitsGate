# Server only. Never prefix these with VITE_ or expose in client code.
DITSGATE_DB=data/ditsgate.sqlite
DITSGATE_API_PORT=5180
# Incoming QRISGate provider webhook HMAC secret ONLY, configured by authorized operator.
# Never use this for merchant outbound webhook settings. Do not commit actual secrets.
QRISGATE_WEBHOOK_SECRET=
# Outbound merchant webhook settings and one-time test credentials are generated by API
# and stored in the server SQLite database; no outbound delivery is enabled.
# Official ShopeePay transaction check (not Shopee Partner portal credentials).
# Backend-only onboarding credentials; leave empty until supplied through a server secret manager.
# SHOPEEPAY_ENV accepts only uat or production. Never set a custom API URL.
SHOPEEPAY_ENV=
SHOPEEPAY_CLIENT_ID=
SHOPEEPAY_SECRET=
SHOPEEPAY_MERCHANT_EXT_ID=
SHOPEEPAY_STORE_EXT_ID=
